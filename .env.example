# ─────────────────────────────────────────────────────────────
# Discord Notify MCP — Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never share or commit this file — it contains your bot token.
# ─────────────────────────────────────────────────────────────

# Your bot token from discord.com/developers/applications
# → Select your app → Bot → Reset Token → Copy
DISCORD_BOT_TOKEN=your_bot_token_here

# The default channel ID to post to (e.g. your #general channel)
# → In Discord: right-click the channel → Copy Channel ID
# → Requires Developer Mode: User Settings → Advanced → Developer Mode → ON
DISCORD_DEFAULT_CHANNEL=your_channel_id_here
